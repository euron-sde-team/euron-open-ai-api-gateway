# Real AWS resources for `make up-aws`. Values come from `terraform output` in
# infra/terraform/envs/aws-dev (or resources you created yourself). No secrets here:
# credentials come from your AWS profile, mounted read-only into the API containers.
AWS_REGION=us-east-1
SES_REGION=us-east-1
SES_CONFIGURATION_SET=<terraform output mail_configuration_set>
MAIL_FROM=Euron Open AI API Gateway <no-reply@<your verified SES domain>>
# Values here win over the compose defaults (make up-aws reads this file as an
# --env-file). Providers stay on the stubs and payments on the fake gateways unless
# you change them: provider keys are added in /admin, payment keys are secrets and
# belong in your git-ignored .env, not here.
# PRODUCT_NAME=Euron Open AI API Gateway
# LOG_LEVEL=info
# FX_PROVIDER=exchangerate
# TOTP_ENCRYPTION_KEY, CREDENTIALS_KEY and API_KEY_PEPPER come from
# deploy/compose/.env (make env), like the other local secrets; do not put them here.

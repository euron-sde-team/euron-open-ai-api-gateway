# Generated by `make env` (scripts/gen-local-env.sh) with random values. Local only.
GW_JWT_SECRET=replace-with-output-of-make-env
GW_REFRESH_SECRET=replace-with-output-of-make-env
# 32 random bytes, base64 (openssl rand -base64 32): encrypts stored TOTP secrets.
GW_TOTP_ENCRYPTION_KEY=replace-with-output-of-make-env
# 32 random bytes, base64: encrypts the provider credentials admins enter in /admin.
# Changing it makes the stored provider keys unreadable (re-enter them).
GW_CREDENTIALS_KEY=replace-with-output-of-make-env
# The HMAC pepper API keys are hashed with. Changing it invalidates every issued key.
GW_API_KEY_PEPPER=replace-with-output-of-make-env
# Every demo account (make demo) signs in with this password.
GW_DEMO_PASSWORD=replace-with-output-of-make-env

# Provider API keys do not go here: sign in as an admin and add them in /admin
# (stored encrypted with GW_CREDENTIALS_KEY). The starter catalogue uses the stubs.

# Payments: the compose defaults point Stripe and Razorpay at the stubs container with
# fake keys and turn on PAYMENTS_STUB. To try a real test-mode account instead, set:
# STRIPE_API_BASE=https://api.stripe.com
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# RAZORPAY_API_BASE=https://api.razorpay.com
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=...
# RAZORPAY_WEBHOOK_SECRET=...
# PAYMENTS_STUB=false

# FX (INR per USD): fixed by default locally.
# FX_PROVIDER=exchangerate        # or openexchangerates (needs FX_API_KEY), fixed
# FX_FIXED_INR_PER_USD=85

# Gateway limits and the base URL shown to developers.
# GATEWAY_PUBLIC_URL=http://localhost:5056/v1
# GATEWAY_MAX_BODY_MB=20
# GATEWAY_MAX_AUDIO_MB=25
# API_KEY_PREFIX=gw-

# Optional overrides (host ports and names)
# GW_PRODUCT_NAME=Euron Open AI API Gateway
# GW_LOG_LEVEL=info
# GW_WEB_PORT=3560
# GW_API_PORT=5056
# GW_PG_PORT=5522
# GW_REDIS_PORT=6459
# GW_MAILPIT_PORT=8076
# GW_SMTP_PORT=1076
# GW_FLOCI_PORT=4627
# GW_STUB_PORT=5149
